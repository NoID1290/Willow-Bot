{
  "version": "2.0.0",
  "nodes": [
    {
      "id": "t1_gather_logs",
      "tier": 1,
      "description": "Harvest at least 4 tree logs by hand",
      "advancement_id": "minecraft:story/root",
      "prerequisites": [],
      "precondition_expr": "None",
      "verification_expr": "Count('*_log') >= 4",
      "base_reward": 40.0,
      "target_items": {"*_log": 4},
      "requires_movement": true,
      "persistent_milestone": false
    },
    {
      "id": "t1_craft_planks_sticks",
      "tier": 1,
      "description": "Craft at least 8 wooden planks and 4 sticks in 2x2 inventory grid",
      "advancement_id": null,
      "prerequisites": ["t1_gather_logs"],
      "precondition_expr": "Count('*_log') >= 3",
      "verification_expr": "Count('*_planks') >= 8 && Count('stick') >= 4",
      "base_reward": 40.0,
      "target_items": {"*_planks": 8, "minecraft:stick": 4},
      "requires_movement": false,
      "persistent_milestone": false
    },
    {
      "id": "t1_craft_table",
      "tier": 1,
      "description": "Craft a crafting_table from 4 planks or locate one nearby",
      "advancement_id": null,
      "prerequisites": ["t1_craft_planks_sticks"],
      "precondition_expr": "Count('*_planks') >= 4",
      "verification_expr": "Count('crafting_table') >= 1 || Nearby('crafting_table')",
      "base_reward": 50.0,
      "target_items": {"minecraft:crafting_table": 1},
      "requires_movement": false,
      "persistent_milestone": false
    },
    {
      "id": "t1_wooden_pickaxe",
      "tier": 1,
      "description": "Place crafting_table and craft a wooden_pickaxe",
      "advancement_id": null,
      "prerequisites": ["t1_craft_table"],
      "precondition_expr": "HasTable && Planks>=3 && Stick>=2",
      "verification_expr": "Count('wooden_pickaxe') >= 1",
      "base_reward": 60.0,
      "target_items": {"minecraft:wooden_pickaxe": 1},
      "requires_movement": false,
      "persistent_milestone": true
    },
    {
      "id": "t2_mine_cobblestone",
      "tier": 2,
      "description": "Mine at least 16 cobblestone using a wooden_pickaxe or better",
      "advancement_id": "minecraft:story/mine_stone",
      "prerequisites": ["t1_wooden_pickaxe"],
      "precondition_expr": "HasPickaxe(>=Wood)",
      "verification_expr": "Count('cobblestone') >= 16",
      "base_reward": 80.0,
      "target_items": {"minecraft:cobblestone": 16},
      "requires_movement": true,
      "persistent_milestone": false
    },
    {
      "id": "t2_stone_tools",
      "tier": 2,
      "description": "Craft stone_pickaxe, stone_axe, and stone_sword at a crafting_table",
      "advancement_id": "minecraft:story/upgrade_tools",
      "prerequisites": ["t2_mine_cobblestone"],
      "precondition_expr": "Cobble >= 11 && Stick >= 6",
      "verification_expr": "Count('stone_pickaxe') >= 1 && Count('stone_axe') >= 1 && Count('stone_sword') >= 1",
      "base_reward": 100.0,
      "target_items": {
        "minecraft:stone_pickaxe": 1,
        "minecraft:stone_axe": 1,
        "minecraft:stone_sword": 1
      },
      "requires_movement": false,
      "persistent_milestone": true
    },
    {
      "id": "t2_acquire_raw_food",
      "tier": 2,
      "description": "Hunt passive animals or harvest crops until holding at least 5 food items",
      "advancement_id": "minecraft:husbandry/root",
      "prerequisites": ["t2_stone_tools"],
      "precondition_expr": "HasSword(>=Stone)",
      "verification_expr": "FoodItemsCount >= 5",
      "base_reward": 85.0,
      "target_items": {"minecraft:beef": 5},
      "requires_movement": true,
      "persistent_milestone": false
    },
    {
      "id": "t2_furnace_and_fuel",
      "tier": 2,
      "description": "Craft a furnace from 8 cobblestone and acquire at least 4 coal or charcoal",
      "advancement_id": null,
      "prerequisites": ["t2_stone_tools"],
      "precondition_expr": "Cobble >= 8",
      "verification_expr": "Count('furnace') >= 1 && (Count('coal') + Count('charcoal') >= 4)",
      "base_reward": 90.0,
      "target_items": {"minecraft:furnace": 1, "minecraft:coal": 4},
      "requires_movement": true,
      "persistent_milestone": false
    },
    {
      "id": "t2_cook_food_and_torches",
      "tier": 2,
      "description": "Cook at least 4 food items in furnace and craft at least 8 torches",
      "advancement_id": null,
      "prerequisites": ["t2_acquire_raw_food", "t2_furnace_and_fuel"],
      "precondition_expr": "HasFurnace && HasFuel",
      "verification_expr": "CookedFoodCount >= 4 && Count('torch') >= 8",
      "base_reward": 100.0,
      "target_items": {"minecraft:cooked_beef": 4, "minecraft:torch": 8},
      "requires_movement": false,
      "persistent_milestone": false
    },
    {
      "id": "t2_survive_night_or_bed",
      "tier": 2,
      "description": "Sleep in a bed to set spawn or construct an enclosed torch-lit shelter",
      "advancement_id": "minecraft:adventure/sleep_in_bed",
      "prerequisites": ["t2_cook_food_and_torches"],
      "precondition_expr": "Torches >= 4",
      "verification_expr": "Unlocked('sleep_in_bed') || EnclosedLitShelterBuilt",
      "base_reward": 120.0,
      "target_items": {"*_bed": 1},
      "requires_movement": true,
      "persistent_milestone": false
    },
    {
      "id": "t3_mine_iron_ore",
      "tier": 3,
      "description": "Mine iron_ore using a stone_pickaxe or better until holding >= 12 raw_iron + iron_ingot",
      "advancement_id": null,
      "prerequisites": ["t2_survive_night_or_bed"],
      "precondition_expr": "HasPickaxe(>=Stone) && Torches>=8",
      "verification_expr": "Count('raw_iron') + Count('iron_ingot') >= 12",
      "base_reward": 150.0,
      "target_items": {"minecraft:raw_iron": 12},
      "requires_movement": true,
      "persistent_milestone": false
    },
    {
      "id": "t3_smelt_iron_ingots",
      "tier": 3,
      "description": "Smelt raw_iron in a furnace until holding at least 12 iron_ingots",
      "advancement_id": "minecraft:story/smelt_iron",
      "prerequisites": ["t3_mine_iron_ore"],
      "precondition_expr": "Count('raw_iron') >= 1",
      "verification_expr": "Count('iron_ingot') >= 12",
      "base_reward": 160.0,
      "target_items": {"minecraft:iron_ingot": 12},
      "requires_movement": false,
      "persistent_milestone": false
    },
    {
      "id": "t3_shield_and_water_bucket",
      "tier": 3,
      "description": "Craft and equip a shield, craft a bucket, and fill water_bucket",
      "advancement_id": null,
      "prerequisites": ["t3_smelt_iron_ingots"],
      "precondition_expr": "IronIngot >= 4 && Planks >= 6",
      "verification_expr": "HasEquippedOrInv('shield') && Count('water_bucket') >= 1",
      "base_reward": 175.0,
      "target_items": {"minecraft:shield": 1, "minecraft:water_bucket": 1},
      "requires_movement": true,
      "persistent_milestone": true
    },
    {
      "id": "t3_iron_tools_and_armor",
      "tier": 3,
      "description": "Craft iron_pickaxe, iron_sword, and equip iron armor reaching >= 10 armor points",
      "advancement_id": "minecraft:story/obtain_armor",
      "prerequisites": ["t3_shield_and_water_bucket"],
      "precondition_expr": "IronIngot >= 13 && Stick >= 4",
      "verification_expr": "Count('iron_pickaxe') >= 1 && Count('iron_sword') >= 1 && ArmorPoints >= 10",
      "base_reward": 220.0,
      "target_items": {
        "minecraft:iron_pickaxe": 1,
        "minecraft:iron_sword": 1,
        "minecraft:iron_chestplate": 1,
        "minecraft:iron_leggings": 1
      },
      "requires_movement": false,
      "persistent_milestone": true
    },
    {
      "id": "t3_slay_hostile_mob",
      "tier": 3,
      "description": "Engage and defeat a hostile mob using iron_sword and shield",
      "advancement_id": "minecraft:adventure/kill_a_mob",
      "prerequisites": ["t3_iron_tools_and_armor"],
      "precondition_expr": "HasSword(>=Iron) && HasShield",
      "verification_expr": "Unlocked('adventure/kill_a_mob')",
      "base_reward": 200.0,
      "target_items": {},
      "requires_movement": true,
      "persistent_milestone": false
    },
    {
      "id": "t4_deep_mining_prep",
      "tier": 4,
      "description": "Prepare for deep Y=-53 mining with >= 32 torches, >= 12 cooked food, and >= 2 iron_pickaxes",
      "advancement_id": null,
      "prerequisites": ["t3_iron_tools_and_armor"],
      "precondition_expr": "HasPickaxe(>=Iron)",
      "verification_expr": "Count('torch') >= 32 && CookedFood >= 12 && Count('iron_pickaxe') >= 2",
      "base_reward": 180.0,
      "target_items": {
        "minecraft:torch": 32,
        "minecraft:cooked_beef": 12,
        "minecraft:iron_pickaxe": 2
      },
      "requires_movement": false,
      "persistent_milestone": false
    },
    {
      "id": "t4_mine_diamonds",
      "tier": 4,
      "description": "Dig stepped staircase to Y=-53 and mine at least 5 diamonds with iron_pickaxe",
      "advancement_id": "minecraft:story/mine_diamond",
      "prerequisites": ["t4_deep_mining_prep"],
      "precondition_expr": "HasPickaxe(>=Iron) && WaterBucket>=1",
      "verification_expr": "Count('diamond') >= 5",
      "base_reward": 400.0,
      "target_items": {"minecraft:diamond": 5},
      "requires_movement": true,
      "persistent_milestone": false
    },
    {
      "id": "t4_craft_diamond_gear",
      "tier": 4,
      "description": "Craft diamond_pickaxe and diamond_sword at crafting_table",
      "advancement_id": "minecraft:story/shiny_gear",
      "prerequisites": ["t4_mine_diamonds"],
      "precondition_expr": "Count('diamond') >= 5 && Stick >= 4",
      "verification_expr": "Count('diamond_pickaxe') >= 1 && Count('diamond_sword') >= 1",
      "base_reward": 350.0,
      "target_items": {
        "minecraft:diamond_pickaxe": 1,
        "minecraft:diamond_sword": 1
      },
      "requires_movement": false,
      "persistent_milestone": true
    },
    {
      "id": "t4_harvest_obsidian",
      "tier": 4,
      "description": "Form and mine at least 10 obsidian blocks using water_bucket and diamond_pickaxe",
      "advancement_id": "minecraft:story/form_obsidian",
      "prerequisites": ["t4_craft_diamond_gear"],
      "precondition_expr": "Count('diamond_pickaxe') >= 1 && WaterBucket >= 1",
      "verification_expr": "Count('obsidian') >= 10",
      "base_reward": 380.0,
      "target_items": {"minecraft:obsidian": 10},
      "requires_movement": true,
      "persistent_milestone": false
    },
    {
      "id": "t5_enter_the_nether",
      "tier": 5,
      "description": "Build obsidian Nether portal frame, ignite with flint_and_steel, and enter the Nether",
      "advancement_id": "minecraft:story/enter_the_nether",
      "prerequisites": ["t4_harvest_obsidian"],
      "precondition_expr": "Count('obsidian') >= 10 && Count('flint_and_steel') >= 1",
      "verification_expr": "Dimension == 'minecraft:the_nether'",
      "base_reward": 750.0,
      "target_items": {"minecraft:obsidian": 10, "minecraft:flint_and_steel": 1},
      "requires_movement": true,
      "persistent_milestone": false
    }
  ]
}
